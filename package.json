{
  "name": "session-review",
  "private": false,
  "version": "0.69.0",
  "skateboardVersion": "5.6.0",
  "type": "module",
  "scripts": {
    "start": "vite --mode development",
    "front": "vite --mode development",
    "build": "npm run typecheck && vite build --mode production",
    "prod": "npm run typecheck && vite build --mode production",
    "test": "npm run typecheck && npm run test:frontend && npm run test:build && npm run test:docs",
    "install-all": "npm install",
    "verify:ui": "node scripts/verify-ui-version.mjs",
    "postinstall": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc -p tsconfig.json",
    "test:frontend": "node --test src/lib/*.test.ts",
    "test:build": "node --experimental-test-module-mocks --test vite.plugins.test.js scripts/verify-ui-version.test.js scripts/update-skateboard.test.js scripts/version-consistency.test.js",
    "test:docs": "node scripts/test-docs.mjs"
  },
  "dependencies": {
    "@stevederico/skateboard-ui": "5.1.0",
    "lucide-react": "0.546.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
